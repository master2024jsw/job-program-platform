PORT=3000
DB_PATH=./data/job-program.sqlite
NODE_ENV=development

# 세션 (로그인)
SESSION_SECRET=change-this-to-a-random-string-in-production
SESSION_IDLE_TIMEOUT_MINUTES=30

# SMTP (메일 자동발송)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="일자리사업 행정자동화 플랫폼 <no-reply@example.com>"

# Gemini (AI 문서 분석)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# IMAP (첨부파일 자동 수집)
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
