PORT=3000
DB_PATH=./data/job-program.sqlite
NODE_ENV=development

# 세션 (로그인)
SESSION_SECRET=change-this-to-a-random-string-in-production
SESSION_IDLE_TIMEOUT_MINUTES=30

# SMTP (메일 자동발송)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="일자리사업 행정자동화 플랫폼 <no-reply@example.com>"

# Gemini (AI 문서 분석)
GEMINI_API_KEY=
# 현재 운영/개발에서 실제로 쓰는 모델. 코드 기본값(gemini.service.ts DEFAULT_MODEL)과 같게 유지할 것.
# 사용 가능한 모델은 키/계정마다 다름. 404 'no longer available'이면 가능한 모델로 교체
# (예: gemini-3.1-flash-lite, gemini-flash-latest)
# 주의: gemini-2.5-flash 는 신규 사용자에게 제공되지 않음 (2026-11 확인)
GEMINI_MODEL=gemini-3.8-flash

# IMAP (첨부파일 자동 수집)
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX

# 스캔 서류 비식별 전송 (2026-11-14)
# 스캔 PDF는 글자가 이미지라서 텍스트 마스킹이 통하지 않는다. 페이지를 렌더링하고 OCR로
# 주민등록번호를 찾아 뒤 6자리를 검은색으로 덮은 뒤, 그 이미지만 AI에 보낸다.
#   redact (기본) : 가린 이미지만 전송. 가릴 위치를 못 찾으면 전송하지 않고 분석 실패로 처리
#   block         : 스캔 서류는 아예 AI로 보내지 않음
#   raw           : 원본 PDF를 그대로 전송 (주민번호가 평문으로 나감 — 권장하지 않음)
AI_SCAN_PDF_POLICY=redact
# 전송용 렌더 배율 (2=약 144dpi, 3=약 216dpi). 올리면 전송량·시간이 배율의 제곱으로 늘어난다.
AI_SCAN_RENDER_SCALE=2
# 주민번호 탐지(OCR)용 배율. 실데이터 확인 결과 2가 가장 안정적이었다(올리면 놓치는 경우가 있음).
AI_SCAN_OCR_SCALE=2
