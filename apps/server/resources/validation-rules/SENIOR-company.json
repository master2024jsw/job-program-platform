{
  "typeCode": "SENIOR",
  "target": "COMPANY",
  "guidelineYear": 2026,
  "source": "2026년도 현장실습 훈련 지원사업 운영안내 — 기업 적격 확인(4단계)",
  "documentFields": {
    "COMPANY_APPLICATION": [
      "businessRegistrationNumber",
      "companyName",
      "representativeName",
      "phone",
      "email",
      "recruitJobTitle",
      "recruitJobCode"
    ],
    "OPERATION_PLAN": [
      "generalTypeCount",
      "intergenerationalTypeCount",
      "plannedHeadcount",
      "representativeConsentToShareAdminInfo"
    ],
    "WORKPLACE_INSURANCE": [
      "businessRegistrationNumber",
      "representativeName",
      "companyName",
      "nationalPension",
      "healthInsurance",
      "industrialAccident",
      "employmentInsurance"
    ],
    "BUSINESS_REGISTRATION": [
      "businessRegistrationNumber",
      "companyName",
      "representativeName",
      "address",
      "businessType",
      "businessItem"
    ]
  },
  "rules": [
    {
      "id": "R-101",
      "type": "crossCheck",
      "label": "사업자등록번호 3자 일치",
      "field": "businessRegistrationNumber",
      "documents": [
        "COMPANY_APPLICATION",
        "BUSINESS_REGISTRATION",
        "WORKPLACE_INSURANCE"
      ],
      "normalize": "brn",
      "onMismatch": "NEEDS_REVIEW"
    },
    {
      "id": "R-102",
      "type": "riskFlag",
      "label": "4대보험 사업장 가입 확인",
      "document": "WORKPLACE_INSURANCE",
      "fields": [
        "nationalPension",
        "healthInsurance",
        "industrialAccident",
        "employmentInsurance"
      ],
      "fieldLabels": {
        "nationalPension": "국민연금",
        "healthInsurance": "건강보험",
        "industrialAccident": "산재보험",
        "employmentInsurance": "고용보험"
      },
      "expected": "가입",
      "onFail": "NEEDS_REVIEW"
    },
    {
      "id": "R-103",
      "type": "riskFlag",
      "label": "대표자 행정정보 공동이용 동의",
      "document": "OPERATION_PLAN",
      "fields": [
        "representativeConsentToShareAdminInfo"
      ],
      "fieldLabels": {
        "representativeConsentToShareAdminInfo": "행정정보 공동이용 동의"
      },
      "expectedBoolean": true,
      "onFail": "NEEDS_REVIEW"
    },
    {
      "id": "R-104",
      "type": "calcRule",
      "label": "모집직종 참여가능 판정",
      "document": "COMPANY_APPLICATION",
      "codeField": "recruitJobCode",
      "titleField": "recruitJobTitle",
      "lookup": "job-classifications",
      "verdictMap": {
        "ELIGIBLE": "PASS",
        "EXCLUDED": "FAIL",
        "NEEDS_REVIEW": "NEEDS_REVIEW"
      },
      "eligibilityLabelMap": {
        "PASS": "가능",
        "FAIL": "제외",
        "NEEDS_REVIEW": "담당자확인"
      },
      "onMissing": "NEEDS_REVIEW"
    }
  ],
  "exceptionRules": [
    {
      "id": "R-101-E1",
      "type": "exceptionRule",
      "label": "법인전환에 따른 사업자등록번호 변경 — 고용승계 확인",
      "appliesWhen": {
        "failedRule": "R-101",
        "verdicts": [
          "NEEDS_REVIEW",
          "FAIL"
        ]
      },
      "conditions": [
        {
          "field": "representativeName",
          "match": "equal",
          "documents": [
            "COMPANY_APPLICATION",
            "BUSINESS_REGISTRATION"
          ]
        },
        {
          "field": "companyName",
          "match": "similar",
          "documents": [
            "COMPANY_APPLICATION",
            "BUSINESS_REGISTRATION"
          ]
        }
      ],
      "onMatch": "NEEDS_REVIEW",
      "guidance": "사업자등록번호는 다르지만 대표자가 같고 상호가 유사합니다 — 사업 기간 중 개인사업자에서 법인으로 전환한 경우일 수 있습니다. 아래 세 가지 서류를 받아 고용승계를 확인하세요. ① 법인양도양수 계약서 ② 고용승계확인서 ③ 개인사업자에서 법인으로 전환된 것이 나타나는 고용보험 가입이력내역서. 세 서류로 동일 사업장 승계가 확인되면 승인하고, 확인 경위를 승인 사유에 남기세요. 서류가 갖춰지지 않으면 승인하지 마세요 — 사업자번호만 다른 별개 사업장일 수 있습니다.",
      "source": {
        "kind": "실무경험",
        "note": "2026-11-14 담당자 확인. 지침은 \"동일 사업장\"을 전제하므로 법인전환 시 사업자번호가 달라져 R-101(3자 대조)에 걸린다. 실무에서는 법인양도양수 계약서·고용승계확인서·법인전환이 반영된 고용보험 가입이력내역서를 받아 고용승계를 확인한다. 탐지 조건(대표자 동일 + 상호 유사)은 단서일 뿐이므로 판정을 바꾸지 않고 서류 요구만 안내한다.",
        "registeredBy": "정세원",
        "registeredAt": "2026-11-14"
      },
      "version": 2
    },
    {
      "id": "R-104-E1",
      "type": "exceptionRule",
      "label": "사무실 업종 + 공유오피스 의심 주소 — 현장확인 필요",
      "appliesWhen": {
        "failedRule": "R-104",
        "verdicts": [
          "PASS",
          "NEEDS_REVIEW",
          "FAIL"
        ]
      },
      "conditions": [
        {
          "field": "businessType",
          "match": "containsAny",
          "document": "BUSINESS_REGISTRATION",
          "keywords": [
            "컨설팅",
            "경영컨설팅",
            "정보통신",
            "소프트웨어",
            "IT",
            "it서비스",
            "시스템통합",
            "응용소프트웨어",
            "사무지원",
            "경영지원",
            "사무서비스",
            "광고",
            "디자인",
            "번역",
            "교육서비스",
            "도매",
            "전자상거래",
            "서비스업"
          ]
        },
        {
          "field": "address",
          "match": "containsAny",
          "document": "BUSINESS_REGISTRATION",
          "keywords": [
            "공유오피스",
            "공유사무실",
            "셰어오피스",
            "쉐어오피스",
            "비즈니스센터",
            "비즈니스타워",
            "위워크",
            "wework",
            "패스트파이브",
            "fastfive",
            "스파크플러스",
            "sparkplus",
            "르호봇",
            "리저스",
            "regus",
            "오피스허브",
            "소호사무실",
            "창업보육센터",
            "1인창조기업",
            "스타트업캠퍼스"
          ]
        }
      ],
      "onMatch": "NEEDS_REVIEW",
      "guidance": "사업자등록증의 업태·종목이 사무실에서 하는 업종이고(컨설팅·IT·사무지원 등), 사업장 소재지가 공유오피스·비즈니스센터로 의심되는 주소입니다. 지침에는 사업장의 장소에 관한 규정이 없으므로 서류만으로는 판단할 수 없습니다. 현장확인을 나가 두 가지를 보고 오세요. ① 그 장소에서 실제로 근무를 하고 있는지 ② 어떤 업무를 하고 있는지. 보고 온 내용을 승인 사유에 남기세요. 주소 표기만으로 걸린 것일 수 있으니 실제로 근무하는 사업장이면 그대로 승인하면 됩니다. 반대로 이 규칙에 걸리지 않아도 안심하지 마세요 — 상호·호실만 적힌 주소나 지식산업센터는 키워드로 잡히지 않으므로 담당자가 따로 보셔야 합니다.",
      "source": {
        "kind": "실무경험",
        "note": "2026-11-14 담당자 등록·확인. 지침에 사업장 장소 규정이 없어 공식 요건으로는 걸러지지 않지만, 사무실 업종 + 공유오피스 주소는 실제 근무 여부를 현장에서 확인해야 하는 사안이다. 현장에서 보는 것은 ① 그 장소에서 실제로 근무하는지 ② 어떤 업무를 하는지 두 가지다(담당자 확인). 업태·종목·주소 키워드는 단서일 뿐이므로 판정을 바꾸지 않고 현장확인 안내만 한다. 주소 키워드는 공유오피스를 명시한 표기만 넣었다(일반 '○○호·○층' 표기는 대부분 기업에 걸려 소용이 없음).",
        "registeredBy": "정세원",
        "registeredAt": "2026-11-14"
      },
      "version": 2
    }
  ]
}
