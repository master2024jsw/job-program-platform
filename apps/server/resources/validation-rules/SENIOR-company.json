{
  "typeCode": "SENIOR",
  "target": "COMPANY",
  "guidelineYear": 2026,
  "source": "2026년도 현장실습 훈련 지원사업 운영안내 — 기업 적격 확인(4단계)",
  "documentFields": {
    "COMPANY_APPLICATION": [
      "businessRegistrationNumber",
      "companyName",
      "representativeName",
      "phone",
      "email",
      "recruitJobTitle",
      "recruitJobCode"
    ],
    "OPERATION_PLAN": [
      "generalTypeCount",
      "intergenerationalTypeCount",
      "plannedHeadcount",
      "representativeConsentToShareAdminInfo"
    ],
    "WORKPLACE_INSURANCE": [
      "businessRegistrationNumber",
      "representativeName",
      "companyName",
      "nationalPension",
      "healthInsurance",
      "industrialAccident",
      "employmentInsurance"
    ],
    "BUSINESS_REGISTRATION": [
      "businessRegistrationNumber",
      "companyName",
      "representativeName"
    ]
  },
  "rules": [
    {
      "id": "R-101",
      "type": "crossCheck",
      "label": "사업자등록번호 3자 일치",
      "field": "businessRegistrationNumber",
      "documents": [
        "COMPANY_APPLICATION",
        "BUSINESS_REGISTRATION",
        "WORKPLACE_INSURANCE"
      ],
      "normalize": "brn",
      "onMismatch": "NEEDS_REVIEW"
    },
    {
      "id": "R-102",
      "type": "riskFlag",
      "label": "4대보험 사업장 가입 확인",
      "document": "WORKPLACE_INSURANCE",
      "fields": [
        "nationalPension",
        "healthInsurance",
        "industrialAccident",
        "employmentInsurance"
      ],
      "fieldLabels": {
        "nationalPension": "국민연금",
        "healthInsurance": "건강보험",
        "industrialAccident": "산재보험",
        "employmentInsurance": "고용보험"
      },
      "expected": "가입",
      "onFail": "NEEDS_REVIEW"
    },
    {
      "id": "R-103",
      "type": "riskFlag",
      "label": "대표자 행정정보 공동이용 동의",
      "document": "OPERATION_PLAN",
      "fields": [
        "representativeConsentToShareAdminInfo"
      ],
      "fieldLabels": {
        "representativeConsentToShareAdminInfo": "행정정보 공동이용 동의"
      },
      "expectedBoolean": true,
      "onFail": "NEEDS_REVIEW"
    },
    {
      "id": "R-104",
      "type": "calcRule",
      "label": "모집직종 참여가능 판정",
      "document": "COMPANY_APPLICATION",
      "codeField": "recruitJobCode",
      "titleField": "recruitJobTitle",
      "lookup": "job-classifications",
      "verdictMap": {
        "ELIGIBLE": "PASS",
        "EXCLUDED": "FAIL",
        "NEEDS_REVIEW": "NEEDS_REVIEW"
      },
      "eligibilityLabelMap": {
        "PASS": "가능",
        "FAIL": "제외",
        "NEEDS_REVIEW": "담당자확인"
      },
      "onMissing": "NEEDS_REVIEW"
    }
  ],
  "exceptionRules": [
    {
      "id": "R-101-E1",
      "type": "exceptionRule",
      "label": "사업 기간 중 법인전환으로 사업자등록번호가 달라진 경우",
      "appliesWhen": { "failedRule": "R-101", "verdicts": ["NEEDS_REVIEW", "FAIL"] },
      "conditions": [
        { "field": "representativeName", "match": "equal", "documents": ["COMPANY_APPLICATION", "BUSINESS_REGISTRATION"] },
        { "field": "companyName", "match": "similar", "documents": ["COMPANY_APPLICATION", "BUSINESS_REGISTRATION"] }
      ],
      "onMatch": "NEEDS_REVIEW",
      "guidance": "사업자등록번호는 다르지만 대표자가 같고 상호가 유사합니다 — 사업 기간 중 개인사업자에서 법인으로 전환한 경우일 수 있습니다. 법인전환 사실과 동일 사업장 승계 여부를 확인하세요(전·후 사업자등록증, 법인 등기사항증명서, 4대보험 사업장 승계 내역). 확인 경위를 승인 사유에 남기세요. ※ 확인 후 처리 기준은 담당자 확인 후 보완 예정입니다.",
      "source": {
        "kind": "실무경험",
        "note": "2026-11-14 담당자가 실제 겪은 상황으로 확인. 설계서 docs/01 §예외처리 항목에도 예정 사례로 기재. 탐지 조건만 우선 등록하고, 확인 후 처리 기준(승계 인정 요건·필요 서류)은 추가 기록 후 보완한다.",
        "registeredBy": "정세원",
        "registeredAt": "2026-11-14"
      },
      "version": 1
    }
  ]
}
