{
  "name": "@job-program/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "package": "electron-builder"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "kr.jobprogram.platform",
    "productName": "잡도리AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/*.map"
    ],
    "extraResources": [
      {
        "from": "../renderer/dist",
        "to": "renderer/dist"
      },
      {
        "from": "../server/dist",
        "to": "server/dist"
      },
      {
        "from": "../server/node_modules",
        "to": "server/node_modules"
      },
      {
        "from": "../server/resources",
        "to": "server/resources",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerLanguages": ["ko_KR"],
      "language": "1042"
    }
  }
}
