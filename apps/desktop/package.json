{
  "name": "@job-program/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "package": "electron-builder"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "kr.jobprogram.platform",
    "productName": "일자리사업 행정자동화 플랫폼",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "../renderer/dist/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
