{
  "name": "job-program-platform",
  "private": true,
  "version": "0.1.0",
  "description": "일자리사업 행정자동화 플랫폼 (Electron + NestJS + SQLite)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n SERVER,RENDERER,DESKTOP -c blue,green,magenta \"npm:dev:server\" \"npm:dev:renderer\" \"npm:dev:desktop\"",
    "dev:server": "npm run start:dev -w apps/server",
    "dev:renderer": "npm run dev -w apps/renderer",
    "dev:desktop": "wait-on tcp:3000 http://localhost:5173 && npm run dev -w apps/desktop",
    "build": "npm run build -w packages/shared && npm run build -w apps/server && npm run build -w apps/renderer && npm run build -w apps/desktop",
    "build:server": "npm run build -w apps/server",
    "build:renderer": "npm run build -w apps/renderer",
    "build:desktop": "npm run build -w apps/desktop",
    "package": "npm run build && npm run package -w apps/desktop",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0",
    "wait-on": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "node-gyp": "^13.0.1"
  }
}
