{
  "name": "job-program-platform",
  "private": true,
  "version": "0.1.0",
  "description": "일자리사업 행정자동화 플랫폼 (Electron + NestJS + SQLite)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n RENDERER,DESKTOP -c green,magenta \"npm:dev:renderer\" \"npm:dev:desktop\"",
    "dev:web": "concurrently -k -n SERVER,RENDERER -c cyan,green \"npm:dev:server\" \"npm:dev:renderer\"",
    "restart": "powershell -ExecutionPolicy Bypass -File scripts/restart.ps1",
    "restart:web": "powershell -ExecutionPolicy Bypass -File scripts/restart.ps1 -Web",
    "restart:server": "powershell -ExecutionPolicy Bypass -File scripts/restart.ps1 -ServerOnly",
    "stop": "powershell -ExecutionPolicy Bypass -File scripts/restart.ps1 -NoStart",
    "dev:server": "npm run start:dev -w apps/server",
    "dev:renderer": "npm run dev -w apps/renderer",
    "dev:desktop": "wait-on http://localhost:5173 && npm run dev -w apps/desktop",
    "build": "npm run build -w packages/shared && npm run build -w apps/server && npm run build -w apps/renderer && npm run build -w apps/desktop",
    "build:server": "npm run build -w apps/server",
    "build:renderer": "npm run build -w apps/renderer",
    "build:desktop": "npm run build -w apps/desktop",
    "package": "npm run check:release && npm run build && npm run package -w apps/desktop",
    "update:local": "npm run check:release && powershell -ExecutionPolicy Bypass -File scripts/update-local.ps1",
    "update:local:run": "npm run check:release && powershell -ExecutionPolicy Bypass -File scripts/update-local.ps1 -Run",
    "update:local:full": "npm run check:release && powershell -ExecutionPolicy Bypass -File scripts/update-local.ps1 -Full -Run",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "reset:documents": "node apps/server/scripts/reset-documents.mjs",
    "reset:test": "node apps/server/scripts/reset-test-data.mjs",
    "reset:test:apply": "node apps/server/scripts/reset-test-data.mjs --apply",
    "reset:test:all": "node apps/server/scripts/reset-test-data.mjs --apply --files",
    "sample:docs": "electron apps/server/scripts/generate-sample-docs.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0",
    "wait-on": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "node-gyp": "^13.0.1"
  },
  "allowScripts": {
    "winax@3.6.9": true,
    "@google/genai@2.12.0": true,
    "@nestjs/core@10.4.22": true,
    "electron@32.3.3": true,
    "esbuild@0.21.5": true,
    "protobufjs@7.6.5": true,
    "better-sqlite3@12.11.1": true
  }
}
