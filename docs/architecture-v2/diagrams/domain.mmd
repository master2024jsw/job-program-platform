        string id PK
        string document_id FK
        string original_asset_id FK
        string scoped_asset_id FK
        string document_type_code
        int version_no
    }
    VALIDATION_RUN {
        string id PK
        string case_id FK
        string policy_version_id FK
        int case_data_revision
        string input_hash
        string verdict
    }
    REVIEW_DECISION {
        string id PK
        string case_id FK
        string validation_run_id FK
